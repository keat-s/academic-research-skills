{
  "name": "ars-studio",
  "version": "0.1.0",
  "private": true,
  "description": "ARS Studio — AI-native academic research, writing, and review app built on the Academic Research Skills suite. Web + mobile + desktop from one codebase.",
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/core build && pnpm --filter ./server build && pnpm --filter ./web build",
    "dev": "pnpm --parallel --filter ./server --filter ./web dev",
    "dev:server": "pnpm --filter ./server dev",
    "dev:web": "pnpm --filter ./web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "desktop": "pnpm --filter ./web tauri dev",
    "mobile:sync": "pnpm --filter ./web cap:sync"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.61.1"
  }
}
