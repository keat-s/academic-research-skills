{
  "name": "@ars/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test --import tsx --import ./src/test-setup.ts ./src/*.test.ts"
  },
  "dependencies": {
    "@ars/core": "workspace:*",
    "@better-auth/stripe": "^1.6.18",
    "@hono/node-server": "^1.13.7",
    "better-auth": "^1.6.18",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.6.14",
    "nodemailer": "^6.9.16",
    "stripe": "^22.2.1",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
