# ---- ARS Studio server config ----
# Copy to app/.env (gitignored) and fill in.

# Port the API server listens on.
PORT=8787

# REQUIRED in production: secret used to sign session JWTs. Generate a long
# random string, e.g.  openssl rand -hex 32
ARS_JWT_SECRET=change-me-to-a-long-random-secret

# Shared OpenRouter key that powers FREE AI for signed-up users. The app routes
# requests to ":free" models. Without this the app still runs in BYOK-only mode
# (every user supplies their own key). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Daily free-message budget per user on the shared key (BYOK bypasses this).
ARS_FREE_DAILY_MESSAGES=40

# SQLite path.
ARS_DB_PATH=./data/ars.db

# Public URL of the web app (used for OpenRouter analytics headers + CORS).
ARS_PUBLIC_URL=http://localhost:5173
ARS_CORS_ORIGINS=*

# Web + server base URLs (used in email links and OAuth redirect URIs).
ARS_WEB_URL=http://localhost:5173
ARS_SERVER_URL=http://localhost:8787

# Require email verification before chatting (off by default; also meaningless
# without SMTP configured).
ARS_REQUIRE_EMAIL_VERIFICATION=false

# Per-IP edge rate limit (abuse protection on auth + AI routes).
ARS_IP_RATE_WINDOW_MS=60000
ARS_IP_RATE_MAX=120

# Token-gated aggregate metrics endpoint (/api/metrics). Unset = endpoint off.
ARS_METRICS_TOKEN=

# ---- Email (optional) ----
# When unset, verification/reset emails are logged to the server console so the
# flows still work locally. Set these to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ARS Studio <noreply@arsstudio.app>

# ---- OAuth (optional) ----
# A provider only appears in the app when both id and secret are set.
# Redirect URI to register: <ARS_SERVER_URL>/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Local model (optional) ----
# Ollama base for on-device inference (Settings → Local backend).
OLLAMA_URL=http://localhost:11434

# ---- Monetization (all optional, all license-safe / non-gating) ----
ARS_DONATE_BMC_URL=https://buymeacoffee.com/crucify020v
ARS_DONATE_KOFI_URL=
ARS_DONATE_GH_URL=
ARS_SPONSOR_SUPPORTER_URL=
ARS_SPONSOR_LAB_URL=
ARS_AFFILIATE_TOOLS_URL=
ARS_GRANTS_URL=

# Bring-your-own-key tip jar (enabled by default; users add their own key).
ARS_BYOK_ENABLED=true

# Single non-tracking ad placement. OFF by default. The licensor should sign
# off before enabling, since CC BY-NC commercial-use boundaries around ads are
# gray. See app/docs/MONETIZATION.md.
ARS_ADS_ENABLED=false
ARS_ADS_PROVIDER=ethicalads
ARS_ADS_PUBLISHER_ID=

# ---- Web build ----
# Where the web app finds the API. Defaults to "/api" (Vite proxy in dev).
# For production set to your deployed API origin, e.g. https://api.example.com/api
VITE_API_BASE=/api
