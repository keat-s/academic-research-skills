{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "noEmit": true,
    // The web app is bundled by Vite and never consumed as a library, so it
    // emits no declarations. This also avoids TS2742 "inferred type cannot be
    // named" errors from deep pnpm-virtual paths in better-auth's client types.
    "declaration": false,
    "composite": false,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
